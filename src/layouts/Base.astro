---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  titel?: string;
  beschreibung?: string;
}
const { titel, beschreibung } = Astro.props;
const seitenTitel = titel ? `${titel} · Well Seasoned` : 'Well Seasoned';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <meta name="theme-color" content="#3D7A4E" />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Theme früh setzen, damit kein Flackern entsteht.
      (() => {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      })();

      // Kochplan-Speicher (localStorage). Im <head> definiert, damit alle
      // Seiten-Skripte (Rezept, Grid, Plan) ihn beim Laden schon nutzen können.
      // Eintrag: { slug, ziel } (Zielportionen).
      window.WSPlan = {
        KEY: 'ws-plan',
        read() {
          try { return JSON.parse(localStorage.getItem(this.KEY)) || []; } catch { return []; }
        },
        write(list) {
          localStorage.setItem(this.KEY, JSON.stringify(list));
          this.updateBadge();
          window.dispatchEvent(new CustomEvent('ws-plan-change'));
        },
        has(slug) { return this.read().some((e) => e.slug === slug); },
        toggle(slug, ziel) {
          const l = this.read();
          const i = l.findIndex((e) => e.slug === slug);
          if (i >= 0) l.splice(i, 1);
          else l.push({ slug, ziel: ziel || 1 });
          this.write(l);
          return i < 0; // true = jetzt drin
        },
        setPortion(slug, ziel) {
          const l = this.read();
          const e = l.find((x) => x.slug === slug);
          if (e) { e.ziel = Math.max(1, ziel); this.write(l); }
        },
        remove(slug) { this.write(this.read().filter((e) => e.slug !== slug)); },
        clear() { this.write([]); },
        count() { return this.read().length; },
        updateBadge() {
          const b = document.getElementById('planBadge');
          if (!b) return;
          const n = this.count();
          b.textContent = n;
          b.hidden = n === 0;
        },
      };
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={url('/')}>Well <span>Seasoned</span></a>
        <nav class="nav">
          <a href={url('/')}>Rezepte</a>
          <a href={url('/suche')}>Suche</a>
          <a href={url('/plan')} class="nav-plan">🛒 Plan<span class="badge" id="planBadge" hidden>0</span></a>
          <a class="nav-add" href="https://github.com/77Striker77/CookBook_AI/issues/new?template=neues-rezept.yml" target="_blank" rel="noreferrer">+ Rezept</a>
          <button class="theme-toggle" id="themeToggle" aria-label="Hell/Dunkel umschalten">◐</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>Well Seasoned · gemeinsam gesammelt</span>
        <span>{new Date().getFullYear()}</span>
      </div>
    </footer>

    <script is:inline>
      const tgl = document.getElementById('themeToggle');
      tgl?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme
          || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      // Badge initial setzen und über Tabs hinweg synchron halten.
      window.WSPlan?.updateBadge();
      window.addEventListener('storage', (e) => { if (e.key === 'ws-plan') window.WSPlan?.updateBadge(); });
      window.addEventListener('ws-plan-change', () => window.WSPlan?.updateBadge());
    </script>
  </body>
</html>
