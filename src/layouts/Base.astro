---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { url } from '../lib/url';
import Speicher from '../components/Speicher.astro';

interface Props {
  titel?: string;
  beschreibung?: string;
  /** Titelbild der Seite — wird als Vorschaubild beim Teilen benutzt. */
  bild?: ImageMetadata;
}
const { titel, beschreibung, bild } = Astro.props;
const seitenTitel = titel ? `${titel} · Well Seasoned` : 'Well Seasoned';
const beschreibungText =
  beschreibung ?? 'Unser gemeinsam gesammeltes digitales Kochbuch.';

// Vorschaubild fürs Teilen (WhatsApp, Signal, …): 1200×630 ist das Maß, das
// alle gängigen Clients erwarten. Absolute URL ist Pflicht — relative Pfade
// werden ignoriert.
const ogBild = bild
  ? await getImage({ src: bild, width: 1200, height: 630, format: 'jpeg', fit: 'cover' })
  : null;
const absolut = (pfad: string) =>
  Astro.site ? new URL(pfad, Astro.site).href : pfad;
const seitenUrl = absolut(Astro.url.pathname);
const fontLatin = url('/fonts/fraunces-latin.woff2');
const fontLatinExt = url('/fonts/fraunces-latin-ext.woff2');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={beschreibungText} />
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1917" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={seitenUrl} />

    <!-- Vorschau beim Teilen. Ohne diese Tags kommt in WhatsApp eine nackte URL. -->
    <meta property="og:site_name" content="Well Seasoned" />
    <meta property="og:type" content={bild ? 'article' : 'website'} />
    <meta property="og:title" content={titel ?? 'Well Seasoned'} />
    <meta property="og:description" content={beschreibungText} />
    <meta property="og:url" content={seitenUrl} />
    <meta property="og:locale" content="de_DE" />
    {ogBild && <meta property="og:image" content={absolut(ogBild.src)} />}
    {ogBild && <meta property="og:image:width" content="1200" />}
    {ogBild && <meta property="og:image:height" content="630" />}
    {ogBild && <meta property="og:image:alt" content={titel ?? 'Well Seasoned'} />}
    <meta name="twitter:card" content={ogBild ? 'summary_large_image' : 'summary'} />

    <!-- Fraunces liegt bei uns, nicht beim Google-CDN. Die @font-face-Regeln
         stehen hier statt in global.css, weil sie den base-Pfad brauchen. -->
    <link
      rel="preload"
      href={fontLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={`
      @font-face {
        font-family: "Fraunces";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("${fontLatin}") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
          U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Fraunces";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("${fontLatinExt}") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
          U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
          U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F,
          U+A720-A7FF;
      }
    `} />

    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Theme früh setzen, damit kein Flackern entsteht.
      (() => {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      })();

    </script>
    <Speicher />
  </head>
  <body>
    <a class="sr-only skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={url('/')}>Well <span>Seasoned</span></a>
        <nav class="nav" aria-label="Hauptnavigation">
          <a href={url('/')}>Rezepte</a>
          <a href={url('/suche')}>Suche</a>
          <a href={url('/plan')} class="nav-plan">
            🛒 Plan<span class="badge" id="planBadge" hidden>0</span>
            <span class="sr-only" id="planStatus" aria-live="polite"></span>
          </a>
          <a class="nav-add" href="https://github.com/77Striker77/CookBook_AI/issues/new?template=neues-rezept.yml" target="_blank" rel="noreferrer">+ Rezept</a>
          <button class="theme-toggle" id="themeToggle" aria-label="Hell/Dunkel umschalten">◐</button>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>Well Seasoned · gemeinsam gesammelt</span>
        <span>{new Date().getFullYear()}</span>
      </div>
    </footer>

    <script is:inline>
      const tgl = document.getElementById('themeToggle');
      tgl?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme
          || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

    </script>
  </body>
</html>
