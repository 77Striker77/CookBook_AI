---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base titel="Suche" beschreibung="Volltextsuche im Kochbuch">
  <div class="wrap suche-wrap reading">
    <p class="eyebrow">Suche</p>
    <h1 style="margin-top:0">Im ganzen Kochbuch suchen</h1>
    <p style="color:var(--muted)">Suche nach Zutaten, Titeln oder Wörtern aus der Zubereitung — z. B. „Zitrone“, „Ofen“, „schnell“.</p>
    <link rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} />
    <div id="search" style="margin-top:20px"></div>
    <noscript>Für die Volltextsuche wird JavaScript benötigt. Du kannst stattdessen auf der Startseite nach Titeln filtern.</noscript>
  </div>

  <script is:inline define:vars={{ jsUrl: url('/pagefind/pagefind-ui.js') }}>
    // Pagefind wird beim Build erzeugt und liegt erst in der veröffentlichten Seite vor.
    const s = document.createElement('script');
    s.src = jsUrl;
    s.onload = () => new PagefindUI({ element: '#search', showSubResults: true, translations: {
      placeholder: 'Rezept oder Zutat suchen …',
      zero_results: 'Nichts gefunden für „[SEARCH_TERM]“',
      clear_search: 'Löschen',
    }});
    s.onerror = () => {
      document.getElementById('search').innerHTML =
        '<p style="color:var(--muted)">Die Suche ist erst nach dem Build verfügbar (nicht in der Dev-Vorschau).</p>';
    };
    document.head.appendChild(s);
  </script>
</Base>
