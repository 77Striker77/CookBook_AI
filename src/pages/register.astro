---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { parseZutaten } from '../lib/zutaten';
import { katLabel, GERAET_LABEL, WARTE_LABEL, warteklasse } from '../lib/darstellung';

const rezepte = await getCollection('rezepte');

// Zutatenindex. Eine Suche verlangt, dass man den Begriff schon kennt —
// ein Register legt den Wortschatz offen und man zeigt darauf. Deshalb
// existiert diese Seite: Die Einträge (/zutat/[slug]) gab es längst, nur
// den Zugang dorthin nicht.
const index = new Map<string, { name: string; n: number }>();
for (const r of rezepte) {
  const gesehen = new Set<string>();
  for (const z of parseZutaten(r.data.zutaten)) {
    if (gesehen.has(z.slug)) continue;
    gesehen.add(z.slug);
    const e = index.get(z.slug) ?? { name: z.kanonisch, n: 0 };
    e.n++;
    index.set(z.slug, e);
  }
}
const zutaten = [...index.entries()]
  .filter(([, e]) => e.n >= 2)
  .sort((a, b) => a[1].name.localeCompare(b[1].name, 'de'));

// Nach Anfangsbuchstaben gruppieren — die Blätterbarkeit ist der Punkt.
const gruppen = new Map<string, typeof zutaten>();
for (const eintrag of zutaten) {
  const b = eintrag[1].name.charAt(0).toUpperCase();
  if (!gruppen.has(b)) gruppen.set(b, []);
  gruppen.get(b)!.push(eintrag);
}

const kategorien = [...new Set(rezepte.map((r) => r.data.kategorie))].sort();
const kuechen = [...new Set(rezepte.map((r) => r.data.küche).filter(Boolean))].sort();
const geraete = [...new Set(rezepte.flatMap((r) => r.data.geraete ?? []))].sort();
const zaehl = (fn: (r: any) => boolean) => rezepte.filter(fn).length;
---

<Base titel="Register" beschreibung="Zutaten, Geräte und Küchen im Überblick.">
  <div class="wrap katalog">
    <p class="eyebrow">Nachschlagen</p>
    <h1>Register</h1>
    <p class="s-unter">
      Wer sucht, muss den Begriff schon kennen. Wer blättert, findet auch, was
      er nicht gesucht hat.
    </p>

    <section class="reg-block">
      <h2 class="s-h2">Nach Zeit</h2>
      <ul class="reg-liste reg-breit">
        <li><a href={url('/alle?zeit=20')}>Höchstens 20 Minuten Arbeit <span>{zaehl((r) => (r.data.zeit_aktiv ?? 999) <= 20)}</span></a></li>
        <li><a href={url('/alle?zeit=35')}>Höchstens 35 Minuten Arbeit <span>{zaehl((r) => (r.data.zeit_aktiv ?? 999) <= 35)}</span></a></li>
        {(['dabei', 'kurz', 'halbe', 'einplanen'] as const).map((w) => (
          <li>
            <a href={url(`/alle?warte=${w}`)}>
              {WARTE_LABEL[w]}
              <span>{zaehl((r) => warteklasse(r.data.zeit_aktiv, r.data.zeit_gesamt) === w)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {geraete.length > 0 && (
      <section class="reg-block">
        <h2 class="s-h2">Nach Gerät</h2>
        <ul class="reg-liste reg-breit">
          {geraete.map((g) => (
            <li>
              <a href={url(`/alle?geraet=${g}`)}>
                {GERAET_LABEL[g] ?? g}
                <span>{zaehl((r) => (r.data.geraete ?? []).includes(g))}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="reg-block">
      <h2 class="s-h2">Nach Art</h2>
      <ul class="reg-liste reg-breit">
        {kategorien.map((k) => (
          <li>
            <a href={url(`/alle?kat=${k}`)}>
              {katLabel(k)}<span>{zaehl((r) => r.data.kategorie === k)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {kuechen.length > 0 && (
      <section class="reg-block">
        <h2 class="s-h2">Nach Küche</h2>
        <ul class="reg-liste reg-breit">
          {kuechen.map((k) => (
            <li>
              <a href={url(`/alle?q=${encodeURIComponent(k!)}`)}>
                {k}<span>{zaehl((r) => r.data.küche === k)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="reg-block">
      <h2 class="s-h2">Zutaten A–Z</h2>
      <p class="s-unter">
        Nur Zutaten, die in mindestens zwei Rezepten vorkommen — eine Seite für
        etwas, das genau einmal auftaucht, beantwortet keine Frage.
      </p>
      {[...gruppen.entries()].map(([buchstabe, eintraege]) => (
        <div class="reg-gruppe">
          <p class="reg-buchstabe" aria-hidden="true">{buchstabe}</p>
          <ul class="reg-liste">
            {eintraege.map(([slug, e]) => (
              <li><a href={url(`/zutat/${slug}`)}>{e.name}<span>{e.n}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </div>
</Base>
