---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { parseZutaten } from '../lib/zutaten';
import { katLabel, arbeitLabel } from '../lib/darstellung';

const rezepte = await getCollection('rezepte');
const katalog = Object.fromEntries(
  rezepte.map((r) => [
    r.id,
    {
      titel: r.data.titel,
      basis: r.data.portionen,
      kategorie: katLabel(r.data.kategorie),
      zeit: arbeitLabel(r.data.zeit_aktiv, r.data.zeit_gesamt) ?? '',
      zutaten: parseZutaten(r.data.zutaten),
    },
  ]),
);
const katalogJson = JSON.stringify(katalog).replace(/</g, '\\u003c');
---

<Base titel="Einkauf" beschreibung="Gewählte Gerichte und die Zutaten dafür.">
  <div class="wrap ek-seite">
    <div class="ek-kopf">
      <h1>Einkauf</h1>
      <p class="ek-fortschritt" id="ekFortschritt" aria-live="polite"></p>
    </div>

    {/* Geteilte Liste: wird angeboten, nie ungefragt übernommen — sonst
        überschreibt ein alter Link den aktuellen Einkauf. */}
    <div class="geteilt" id="ekGeteilt" hidden>
      <p class="eg-kopf">Geteilte Liste</p>
      <p id="egText"></p>
      <div class="eg-knoepfe">
        <button class="btn primary" id="egUebernehmen">Übernehmen</button>
        <button class="btn ghost" id="egVerwerfen">Verwerfen</button>
      </div>
    </div>

    <div id="ekLeer" class="leer-box" hidden>
      <p>Noch keine Gerichte gewählt.</p>
      <p class="muted">Tippe bei einem Rezept auf das <b>+</b> — die Zutaten sammeln sich hier.</p>
      <a class="btn primary" href={url('/rezepte')}>Zu den Rezepten</a>
    </div>

    <div id="ekInhalt" hidden>
      <!-- Oben: was gekocht wird. Darunter: was dafür fehlt. -->
      <section class="ek-gerichte">
        <h2 class="ek-abschnitt">Gerichte</h2>
        <ul id="ekGerichte"></ul>
      </section>

      <section class="ek-liste-block">
        <h2 class="ek-abschnitt">Zutaten</h2>
        <form class="ek-zufuegen" id="ekForm">
          <label class="sr-only" for="ekNeu">Etwas hinzufügen</label>
          <input id="ekNeu" type="text" placeholder="Milch, Kaffee, Spülmittel …" autocomplete="off" />
          <button class="btn" type="submit">Hinzufügen</button>
        </form>
        <div id="ekGruppen"></div>
      </section>

      <div class="ek-werkzeuge">
        <button class="btn ghost small" id="ekKopieren">Kopieren</button>
        <button class="btn ghost small" id="ekTeilen" hidden>Teilen</button>
        <button class="btn ghost small" id="ekDrucken">Drucken</button>
        <button class="btn ghost small" id="ekHaken">Haken zurücksetzen</button>
        <button class="btn ghost small danger" id="ekLeeren">Alles leeren</button>
      </div>
    </div>
  </div>

  <script>
    import { aggregiere, alsText, CHECK_KEY, gruppeFuer, istVorrat, GRUPPEN } from '../lib/einkauf';

    const EIGEN_KEY = 'ws-einkauf-eigen';
    const katalog = JSON.parse(document.getElementById('katalog').textContent);
    const leerEl = document.getElementById('ekLeer');
    const inhaltEl = document.getElementById('ekInhalt');
    const gerichteEl = document.getElementById('ekGerichte');
    const gruppenEl = document.getElementById('ekGruppen');
    const fortschrittEl = document.getElementById('ekFortschritt');
    let zeilen = [];

    const lade = (k, f) => { try { return JSON.parse(localStorage.getItem(k)) ?? f; } catch { return f; } };
    const ladeHaken = () => new Set(lade(CHECK_KEY, []));
    const speichereHaken = (s) => localStorage.setItem(CHECK_KEY, JSON.stringify([...s]));
    const ladeEigen = () => lade(EIGEN_KEY, []);
    const speichereEigen = (l) => localStorage.setItem(EIGEN_KEY, JSON.stringify(l));
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const basisPfad = document.querySelector('link[rel="manifest"]').getAttribute('href').replace(/\/manifest\.webmanifest$/, '');

    function render() {
      const plan = window.WSPlan.read().filter((e) => katalog[e.slug]);
      const eigen = ladeEigen();
      const etwasDa = plan.length > 0 || eigen.length > 0;
      leerEl.hidden = etwasDa;
      inhaltEl.hidden = !etwasDa;
      if (!etwasDa) { fortschrittEl.textContent = ''; return; }

      // --- Gerichte ---
      gerichteEl.innerHTML = plan.map((e) => {
        const r = katalog[e.slug];
        return `<li class="ek-gericht">
          <div class="eg-text">
            <a class="eg-titel" href="${basisPfad}/rezept/${esc(e.slug)}">${esc(r.titel)}</a>
            <span class="eg-meta">${esc(r.kategorie)}${r.zeit ? ' · ' + esc(r.zeit) : ''}</span>
          </div>
          <div class="eg-stepper" data-slug="${esc(e.slug)}">
            <button class="minus" aria-label="weniger Portionen">−</button>
            <span class="eg-portion">${e.ziel}</span>
            <span class="eg-lbl">Port.</span>
            <button class="plus" aria-label="mehr Portionen">+</button>
          </div>
          <button class="eg-weg" data-slug="${esc(e.slug)}" aria-label="Entfernen">×</button>
        </li>`;
      }).join('') || '<li class="ek-hinweis">Keine Gerichte gewählt — die Liste unten ist selbst eingetragen.</li>';

      // --- Zutaten ---
      const ausPlan = aggregiere(
        plan.map((e) => ({
          slug: e.slug, titel: katalog[e.slug].titel,
          basis: katalog[e.slug].basis, ziel: e.ziel, zutaten: katalog[e.slug].zutaten,
        })),
      ).filter((z) => !istVorrat(z.kanonisch));

      zeilen = [
        ...ausPlan,
        ...eigen.map((t) => ({ key: 'eigen|' + t, kanonisch: t, text: '', herkunft: [], ungenau: false, eigen: true })),
      ];

      const haken = ladeHaken();
      for (const k of [...haken]) if (!zeilen.some((z) => z.key === k)) haken.delete(k);
      speichereHaken(haken);

      const nachGruppe = new Map();
      for (const z of zeilen) {
        const g = z.eigen ? 'Sonstiges' : gruppeFuer(z.kanonisch);
        if (!nachGruppe.has(g)) nachGruppe.set(g, []);
        nachGruppe.get(g).push(z);
      }

      gruppenEl.innerHTML = '';
      for (const g of GRUPPEN) {
        const liste = nachGruppe.get(g);
        if (!liste?.length) continue;
        liste.sort((a, b) => (haken.has(a.key) ? 1 : 0) - (haken.has(b.key) ? 1 : 0)
          || a.kanonisch.localeCompare(b.kanonisch, 'de'));
        const sec = document.createElement('section');
        sec.className = 'ek-gruppe';
        sec.innerHTML = `<h3>${esc(g)}</h3><ul>${liste.map((z) => {
          const ab = haken.has(z.key);
          return `<li class="ek-item${ab ? ' ab' : ''}">
            <label>
              <input type="checkbox" data-key="${esc(z.key)}"${ab ? ' checked' : ''} />
              <span class="ek-name">${esc(z.kanonisch)}</span>
              ${z.text ? `<span class="ek-menge${z.ungenau ? ' ungenau' : ''}">${esc(z.text)}</span>` : ''}
              ${z.herkunft.length > 1 ? `<span class="ek-herkunft">${z.herkunft.length}×</span>` : ''}
              ${z.eigen ? `<button class="ek-weg" data-eigen="${esc(z.kanonisch)}" aria-label="Entfernen">×</button>` : ''}
            </label></li>`;
        }).join('')}</ul>`;
        gruppenEl.appendChild(sec);
      }

      const offen = zeilen.filter((z) => !haken.has(z.key)).length;
      fortschrittEl.textContent = zeilen.length === 0 ? ''
        : offen === 0 ? 'Alles im Wagen ✓'
        : `${zeilen.length - offen} von ${zeilen.length} erledigt`;
    }

    gerichteEl.addEventListener('click', (ev) => {
      const step = ev.target.closest('.eg-stepper');
      if (step) {
        const e = window.WSPlan.read().find((x) => x.slug === step.dataset.slug);
        if (!e) return;
        if (ev.target.classList.contains('plus')) window.WSPlan.setPortion(e.slug, e.ziel + 1);
        else if (ev.target.classList.contains('minus') && e.ziel > 1) window.WSPlan.setPortion(e.slug, e.ziel - 1);
        return;
      }
      const weg = ev.target.closest('.eg-weg');
      if (weg) window.WSPlan.remove(weg.dataset.slug);
    });

    gruppenEl.addEventListener('change', (ev) => {
      const cb = ev.target.closest('input[type=checkbox]');
      if (!cb) return;
      const haken = ladeHaken();
      cb.checked ? haken.add(cb.dataset.key) : haken.delete(cb.dataset.key);
      speichereHaken(haken);
      render();
    });
    gruppenEl.addEventListener('click', (ev) => {
      const weg = ev.target.closest('.ek-weg');
      if (!weg) return;
      ev.preventDefault();
      speichereEigen(ladeEigen().filter((t) => t !== weg.dataset.eigen));
      render();
    });

    document.getElementById('ekForm').addEventListener('submit', (ev) => {
      ev.preventDefault();
      const feld = document.getElementById('ekNeu');
      const wert = feld.value.trim();
      if (!wert) return;
      const l = ladeEigen();
      if (!l.includes(wert)) l.push(wert);
      speichereEigen(l);
      feld.value = '';
      render();
    });

    function blitz(el, text) {
      const alt = el.textContent;
      el.textContent = text;
      setTimeout(() => { el.textContent = alt; }, 1400);
    }
    document.getElementById('ekKopieren').addEventListener('click', async (ev) => {
      try { await navigator.clipboard.writeText('Einkaufsliste\n' + alsText(zeilen)); blitz(ev.target, 'Kopiert ✓'); }
      catch { blitz(ev.target, 'Ging nicht'); }
    });
    /* ------------------------------------------------------------------
       Teilen zwischen zwei Geräten.

       Der Plan liegt in localStorage — also auf EINEM Gerät. Bei einem Paar
       heißt das: Einer stellt am Desktop die Woche zusammen, der andere steht
       im Laden ohne Liste. Das bricht den Kernkreislauf in der Mitte.

       Ohne Backend lösbar, indem der Plan in den URL-Hash wandert. Der Hash
       wird nie an den Server geschickt, bleibt also auch bei GitHub Pages
       privat. Bewusst lesbar statt base64 — man sieht, was man verschickt.
       ------------------------------------------------------------------ */
    function teilenUrl() {
      const plan = window.WSPlan.read().filter((e) => katalog[e.slug]);
      const teile = [];
      if (plan.length) teile.push('plan=' + plan.map((e) => `${e.slug}:${e.ziel}`).join(','));
      const eigen = ladeEigen();
      if (eigen.length) teile.push('extra=' + eigen.map(encodeURIComponent).join('~'));
      return location.origin + location.pathname + (teile.length ? '#' + teile.join('&') : '');
    }

    const teilen = document.getElementById('ekTeilen');
    teilen.hidden = false;
    teilen.addEventListener('click', async (ev) => {
      const url = teilenUrl();
      const text = 'Einkaufsliste\n' + alsText(zeilen);
      if (navigator.share) {
        try { await navigator.share({ title: 'Einkaufsliste', text, url }); return; } catch { /* abgebrochen */ }
      }
      try { await navigator.clipboard.writeText(url); blitz(ev.target, 'Link kopiert ✓'); }
      catch { blitz(ev.target, 'Ging nicht'); }
    });

    /** Geteilten Plan aus dem Hash lesen — aber nie ungefragt übernehmen. */
    function geteiltenPlanPruefen() {
      const hash = location.hash.slice(1);
      if (!hash) return;
      const p = new URLSearchParams(hash);
      const roh = p.get('plan') ?? '';
      const gerichte = roh.split(',').filter(Boolean).map((t) => {
        const [slug, ziel] = t.split(':');
        return { slug, ziel: Math.max(1, Number(ziel) || 1), tag: 0 };
      }).filter((e) => katalog[e.slug]);
      const extra = (p.get('extra') ?? '').split('~').filter(Boolean).map(decodeURIComponent);
      if (!gerichte.length && !extra.length) return;

      const kasten = document.getElementById('ekGeteilt');
      document.getElementById('egText').textContent =
        `${gerichte.length} ${gerichte.length === 1 ? 'Gericht' : 'Gerichte'}` +
        (extra.length ? ` und ${extra.length} eigene ${extra.length === 1 ? 'Zeile' : 'Zeilen'}` : '') +
        ' aus einer geteilten Liste.';
      kasten.hidden = false;

      document.getElementById('egUebernehmen').addEventListener('click', () => {
        window.WSPlan.write(gerichte);
        speichereEigen([...new Set([...ladeEigen(), ...extra])]);
        history.replaceState(null, '', location.pathname);
        kasten.hidden = true;
        render();
      });
      document.getElementById('egVerwerfen').addEventListener('click', () => {
        history.replaceState(null, '', location.pathname);
        kasten.hidden = true;
      });
    }
    geteiltenPlanPruefen();
    document.getElementById('ekDrucken').addEventListener('click', () => window.print());
    document.getElementById('ekHaken').addEventListener('click', () => { speichereHaken(new Set()); render(); });
    document.getElementById('ekLeeren').addEventListener('click', () => {
      if (!confirm('Gerichte und Liste komplett leeren?')) return;
      speichereEigen([]); speichereHaken(new Set()); window.WSPlan.clear();
    });

    window.addEventListener('ws-plan-change', render);
    render();
  </script>

  <script type="application/json" id="katalog" set:html={katalogJson}></script>
</Base>
