---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { verlauf, katLabel, zeitLabel } from '../lib/darstellung';

const alle = (await getCollection('rezepte')).sort((a, b) =>
  a.data.titel.localeCompare(b.data.titel, 'de'),
);

// Kategorien und Tags fürs Filtern einsammeln.
const kategorien = [...new Set(alle.map((r) => r.data.kategorie))].sort();
const topTags = [...new Set(alle.flatMap((r) => r.data.tags))].sort().slice(0, 8);

const rezepte = alle.map((r) => ({
  slug: r.id,
  titel: r.data.titel,
  kategorie: r.data.kategorie,
  tags: r.data.tags,
  zeit: r.data.zeit_gesamt ?? 0,
  bewertung: r.data.bewertung ?? 0,
  portionen: r.data.portionen,
  bild: r.data.bild,
}));
---

<Base beschreibung="Well Seasoned — unser gemeinsam gesammeltes digitales Kochbuch.">
  <section class="hero-band">
    <div class="wrap hero">
      <p class="eyebrow">Gemeinsam gesammelt</p>
      <h1>Well <span class="accent">Seasoned</span></h1>
      <p class="hero-sub">Erprobte Lieblingsrezepte, über die Zeit zusammengekocht. Stöbern, filtern oder einfach überraschen lassen.</p>
      <div class="hero-stats">
        <span><b>{alle.length}</b> Rezepte</span>
        <span class="dot" aria-hidden="true">·</span>
        <span><b>{kategorien.length}</b> Kategorien</span>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="controls">
      <label class="searchfield">
        🔍 <input type="search" id="q" placeholder="Suchen … Titel eingeben" autocomplete="off" />
      </label>
      <button class="btn" id="random">🎲 Überrasch mich</button>
    </div>

    <div class="chips" id="katChips">
      <button class="chip" data-kat="" aria-pressed="true">Alle</button>
      {kategorien.map((k) => <button class="chip" data-kat={k} aria-pressed="false">{katLabel(k)}</button>)}
    </div>
    <div class="chips" id="tagChips">
      {topTags.map((t) => <button class="chip" data-tag={t} aria-pressed="false">#{t}</button>)}
      <button class="chip" data-time="30" aria-pressed="false">≤ 30 min</button>
    </div>

    <p class="count" id="count"></p>

    <div class="grid" id="grid">
      {rezepte.map((r) => (
        <a
          class="rcard"
          href={url(`/rezept/${r.slug}`)}
          data-titel={r.titel.toLowerCase()}
          data-kat={r.kategorie}
          data-tags={r.tags.join(' ')}
          data-zeit={r.zeit}
        >
          <div class="thumb" style={`background:${verlauf(r.kategorie)}`}>
            {r.bild && <Image src={r.bild} alt={r.titel} widths={[260, 460]} sizes="260px" />}
            <span class="kat">{katLabel(r.kategorie)}</span>
          </div>
          <div class="body">
            <span class="title">{r.titel}</span>
            <span class="meta">
              {zeitLabel(r.zeit) && <span>{zeitLabel(r.zeit)}</span>}
              <span>{r.portionen} Portionen</span>
            </span>
            {r.bewertung > 0 && <span class="stars">{'★'.repeat(r.bewertung)}{'☆'.repeat(5 - r.bewertung)}</span>}
          </div>
        </a>
      ))}
    </div>
  </div>

  <script is:inline define:vars={{ homeUrl: url('/') }}>
    const grid = document.getElementById('grid');
    const cards = [...grid.querySelectorAll('.rcard')];
    const q = document.getElementById('q');
    const count = document.getElementById('count');
    const state = { text: '', kat: '', tag: '', time: 0 };

    function apply() {
      let n = 0;
      for (const c of cards) {
        const okText = !state.text || c.dataset.titel.includes(state.text);
        const okKat = !state.kat || c.dataset.kat === state.kat;
        const okTag = !state.tag || c.dataset.tags.split(' ').includes(state.tag);
        const okTime = !state.time || Number(c.dataset.zeit) > 0 && Number(c.dataset.zeit) <= state.time;
        const show = okText && okKat && okTag && okTime;
        c.style.display = show ? '' : 'none';
        if (show) n++;
      }
      count.textContent = n === cards.length ? `${n} Rezepte` : `${n} von ${cards.length} Rezepten`;
      let leer = grid.querySelector('.empty');
      if (n === 0 && !leer) {
        leer = document.createElement('p');
        leer.className = 'empty';
        leer.textContent = 'Nichts gefunden — Filter zurücksetzen?';
        grid.appendChild(leer);
      } else if (n > 0 && leer) leer.remove();
    }

    q.addEventListener('input', () => { state.text = q.value.trim().toLowerCase(); apply(); });

    document.getElementById('katChips').addEventListener('click', (e) => {
      const b = e.target.closest('[data-kat]'); if (!b) return;
      state.kat = b.dataset.kat;
      for (const c of e.currentTarget.children) c.setAttribute('aria-pressed', String(c === b));
      apply();
    });

    document.getElementById('tagChips').addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      const pressed = b.getAttribute('aria-pressed') === 'true';
      for (const c of e.currentTarget.children) c.setAttribute('aria-pressed', 'false');
      if ('time' in b.dataset) { state.tag = ''; state.time = pressed ? 0 : Number(b.dataset.time); }
      else { state.time = 0; state.tag = pressed ? '' : b.dataset.tag; }
      if (!pressed) b.setAttribute('aria-pressed', 'true');
      apply();
    });

    document.getElementById('random').addEventListener('click', () => {
      const sichtbar = cards.filter((c) => c.style.display !== 'none');
      const pool = sichtbar.length ? sichtbar : cards;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      if (pick) location.href = pick.getAttribute('href');
    });

    apply();
  </script>
</Base>
