---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { katLabel, zeitLabel } from '../lib/darstellung';

const alle = (await getCollection('rezepte')).sort((a, b) =>
  a.data.titel.localeCompare(b.data.titel, 'de'),
);

// Kategorien und Tags fürs Filtern einsammeln.
const kategorien = [...new Set(alle.map((r) => r.data.kategorie))].sort();
const topTags = [...new Set(alle.flatMap((r) => r.data.tags))].sort().slice(0, 8);

const rezepte = alle.map((r) => ({
  slug: r.id,
  titel: r.data.titel,
  kategorie: r.data.kategorie,
  tags: r.data.tags,
  zeit: r.data.zeit_gesamt ?? 0,
  portionen: r.data.portionen,
  bild: r.data.bild,
}));
---

<Base beschreibung="Well Seasoned — unser gemeinsam gesammeltes digitales Kochbuch.">
  <section class="hero-band">
    <div class="wrap hero">
      <p class="eyebrow">Gemeinsam gesammelt</p>
      <h1><span>Well</span><span class="accent">Seasoned</span></h1>
      <div class="hero-foot">
        <p class="hero-sub">Erprobte Lieblingsrezepte, über die Zeit zusammengekocht. Stöbern, filtern oder einfach überraschen lassen.</p>
        <p class="hero-stats">
          <span><b>{alle.length}</b> Rezepte</span>
          <span class="dot" aria-hidden="true">·</span>
          <span><b>{kategorien.length}</b> Kategorien</span>
        </p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="controls">
      <label class="searchfield">
        <span aria-hidden="true">🔍</span>
        <input type="search" id="q" placeholder="Rezept suchen …" autocomplete="off" aria-label="Rezepte nach Titel filtern" />
      </label>
      <button class="btn" id="random">🎲 Überrasch mich</button>
    </div>

    <div class="chips" id="katChips" role="group" aria-label="Nach Kategorie filtern">
      <button class="chip" data-kat="" aria-pressed="true">Alle</button>
      {kategorien.map((k) => <button class="chip" data-kat={k} aria-pressed="false">{katLabel(k)}</button>)}
    </div>
    <div class="chips" id="tagChips" role="group" aria-label="Nach Merkmal filtern">
      {topTags.map((t) => <button class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
      <button class="chip" data-time="30" aria-pressed="false">≤ 30 min</button>
    </div>

    <p class="count" id="count" aria-live="polite"></p>

    <div class="grid" id="grid">
      {rezepte.map((r, i) => (
        <article
          class="rcard"
          data-pos={i % 6}
          data-titel={r.titel.toLowerCase()}
          data-kat={r.kategorie}
          data-tags={r.tags.join(' ')}
          data-zeit={r.zeit}
        >
          <div class="thumb">
            {/* alt bleibt leer: der Titel direkt daneben benennt das Gericht
                bereits, sonst liest der Screenreader alles doppelt. */}
            {r.bild && <Image src={r.bild} alt="" widths={[320, 560, 900]} sizes="(max-width: 780px) 100vw, 45vw" loading={i < 3 ? 'eager' : 'lazy'} />}
          </div>
          <div class="body">
            <span class="nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="kat">{katLabel(r.kategorie)}</span>
            <a class="title" href={url(`/rezept/${r.slug}`)}>{r.titel}</a>
            <span class="meta">
              {zeitLabel(r.zeit) && <span>{zeitLabel(r.zeit)}</span>}
              <span>{r.portionen} Portionen</span>
            </span>
          </div>
          <button
            class="add-plan"
            data-slug={r.slug}
            data-basis={r.portionen}
            aria-label={`„${r.titel}" zum Kochplan hinzufügen`}
            aria-pressed="false"
          >+</button>
        </article>
      ))}
      <p class="empty" id="empty" hidden>Nichts gefunden — Filter zurücksetzen?</p>
    </div>
  </div>

  <script is:inline>
    const grid = document.getElementById('grid');
    const cards = [...grid.querySelectorAll('.rcard')];
    const q = document.getElementById('q');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    const state = { text: '', kat: '', tag: '', time: 0 };

    // Das Editorial-Raster hat einen Rhythmus von sechs Karten in drei Größen:
    // volle Breite, zwei Hälften, drei Drittel. Position nach jedem Filtern neu —
    // sonst zählt CSS die versteckten Karten mit und der Rhythmus zerfällt.
    function apply() {
      let n = 0;
      for (const c of cards) {
        const okText = !state.text || c.dataset.titel.includes(state.text);
        const okKat = !state.kat || c.dataset.kat === state.kat;
        const okTag = !state.tag || c.dataset.tags.split(' ').includes(state.tag);
        const okTime = !state.time || (Number(c.dataset.zeit) > 0 && Number(c.dataset.zeit) <= state.time);
        const show = okText && okKat && okTag && okTime;
        c.hidden = !show;
        if (show) {
          c.dataset.pos = n % 6;
          c.querySelector('.nr').textContent = String(n + 1).padStart(2, '0');
          n++;
        }
      }
      count.textContent = n === cards.length ? `${n} Rezepte` : `${n} von ${cards.length} Rezepten`;
      empty.hidden = n > 0;
    }

    q.addEventListener('input', () => { state.text = q.value.trim().toLowerCase(); apply(); });

    document.getElementById('katChips').addEventListener('click', (e) => {
      const b = e.target.closest('[data-kat]'); if (!b) return;
      state.kat = b.dataset.kat;
      for (const c of e.currentTarget.children) c.setAttribute('aria-pressed', String(c === b));
      apply();
    });

    document.getElementById('tagChips').addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      const pressed = b.getAttribute('aria-pressed') === 'true';
      for (const c of e.currentTarget.children) c.setAttribute('aria-pressed', 'false');
      if ('time' in b.dataset) { state.tag = ''; state.time = pressed ? 0 : Number(b.dataset.time); }
      else { state.time = 0; state.tag = pressed ? '' : b.dataset.tag; }
      if (!pressed) b.setAttribute('aria-pressed', 'true');
      apply();
    });

    document.getElementById('random').addEventListener('click', () => {
      const sichtbar = cards.filter((c) => !c.hidden);
      const pool = sichtbar.length ? sichtbar : cards;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      if (pick) location.href = pick.querySelector('.title').getAttribute('href');
    });

    // Schnell-Hinzufügen direkt aus dem Raster, ohne das Rezept zu öffnen.
    const addBtns = [...grid.querySelectorAll('.add-plan')];
    function paintAdd() {
      for (const b of addBtns) {
        const on = window.WSPlan?.has(b.dataset.slug);
        b.setAttribute('aria-pressed', String(!!on));
        b.textContent = on ? '✓' : '+';
      }
    }
    grid.addEventListener('click', (e) => {
      const b = e.target.closest('.add-plan');
      if (!b) return;
      window.WSPlan.toggle(b.dataset.slug, Number(b.dataset.basis) || 1);
      paintAdd();
    });
    window.addEventListener('ws-plan-change', paintAdd);
    paintAdd();

    apply();
  </script>
</Base>
