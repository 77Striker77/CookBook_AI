---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { katLabel } from '../lib/darstellung';

const alle = await getCollection('rezepte');

// Kategorien mit Anzahl — das sind die Sprungmarken des Dashboards.
const kategorien = [...new Set(alle.map((r) => r.data.kategorie))]
  .map((k) => ({ k, n: alle.filter((r) => r.data.kategorie === k).length }))
  .sort((a, b) => b.n - a.n);

const geraete = [...new Set(alle.flatMap((r) => r.data.geraete ?? []))];
const schnell = alle.filter((r) => (r.data.zeit_aktiv ?? 999) <= 20).length;
---

<Base beschreibung={`Unser digitales Kochbuch — ${alle.length} Rezepte.`}>
  <div class="wrap dash">
    <!-- Drei Bereiche, drei Kacheln. Jede zeigt ihren Zustand und führt
         hinein. Das ist die ganze Aufgabe dieser Seite. -->
    <nav class="dash-haupt" aria-label="Bereiche">
      <a class="kachel kachel-gross" href={url('/rezepte')}>
        <span class="kachel-zahl">{alle.length}</span>
        <span class="kachel-titel">Rezepte</span>
        <span class="kachel-unter">Alle ansehen, filtern, suchen</span>
      </a>

      <a class="kachel" href={url('/einkauf')}>
        <span class="kachel-zahl" id="dashPlan">0</span>
        <span class="kachel-titel">Einkauf</span>
        <span class="kachel-unter" id="dashPlanUnter">Noch nichts gewählt</span>
      </a>
    </nav>

    <!-- Direktsprünge in die Rezeptliste. Der eigentliche Zweck des
         Dashboards: schneller dorthin, wo man ohnehin hinwill. -->
    <section class="dash-block">
      <h2 class="dash-h2">Nach Art</h2>
      <ul class="sprung">
        {kategorien.map(({ k, n }) => (
          <li>
            <a href={url(`/rezepte?kat=${k}`)}>
              {katLabel(k)}<span>{n}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="dash-block">
      <h2 class="dash-h2">Nach Aufwand</h2>
      <ul class="sprung">
        <li><a href={url('/rezepte?zeit=20')}>Höchstens 20 Minuten Arbeit<span>{schnell}</span></a></li>
        <li><a href={url('/rezepte?warte=einplanen')}>Läuft von allein<span>{alle.filter((r) => (r.data.zeit_gesamt ?? 0) - (r.data.zeit_aktiv ?? 0) >= 60).length}</span></a></li>
        {geraete.map((g) => (
          <li>
            <a href={url(`/rezepte?geraet=${g}`)}>
              {g === 'airfryer' ? 'Airfryer' : g === 'ofen' ? 'Ofen' : g}
              <span>{alle.filter((r) => (r.data.geraete ?? []).includes(g)).length}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <script is:inline>
    (() => {
      const zahl = document.getElementById('dashPlan');
      const unter = document.getElementById('dashPlanUnter');
      function zeichnen() {
        const n = window.WSPlan?.count() ?? 0;
        zahl.textContent = n;
        unter.textContent = n === 0
          ? 'Noch nichts gewählt'
          : `${n === 1 ? 'Gericht' : 'Gerichte'} — Zutatenliste ansehen`;
      }
      window.addEventListener('ws-plan-change', zeichnen);
      zeichnen();
    })();
  </script>
</Base>
