---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rezeptkarte from '../components/Rezeptkarte.astro';
import Kartenlogik from '../components/Kartenlogik.astro';
import { katLabel, GERAET_LABEL, WARTE_LABEL } from '../lib/darstellung';

const alle = (await getCollection('rezepte')).sort((a, b) =>
  a.data.titel.localeCompare(b.data.titel, 'de'),
);

const kategorien = [...new Set(alle.map((r) => r.data.kategorie))].sort();
const geraete = [...new Set(alle.flatMap((r) => r.data.geraete ?? []))].sort();

// Tags nach HÄUFIGKEIT, nicht alphabetisch. Vorher stand hier
// `.sort().slice(0, 8)` — das zeigte „3-zutaten, air-fryer, airfryer, backen,
// blaubeeren, blech, blechkuchen, bowl": sieben der acht filterten auf genau
// ein Rezept, während hähnchen (8), meal-prep (6) und high-protein (6)
// unerreichbar waren.
const tagZaehler = new Map<string, number>();
for (const r of alle) {
  for (const t of r.data.tags ?? []) tagZaehler.set(t, (tagZaehler.get(t) ?? 0) + 1);
}
const topTags = [...tagZaehler.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'de'))
  .slice(0, 10);
---

<Base titel="Alle Rezepte" beschreibung={`Alle ${alle.length} Rezepte im Kochbuch, filterbar nach Zeit, Gerät und Art.`}>
  <div class="wrap katalog">
    <p class="eyebrow">Register</p>
    <h1>Alle Rezepte</h1>

    <form class="filter" id="filter" role="search">
      <label class="f-suche">
        <span class="sr-only">Suchen</span>
        <input type="search" name="q" id="fQ" placeholder="Rezept oder Zutat suchen …" autocomplete="off" />
      </label>

      <fieldset class="f-gruppe">
        <legend>Arbeitszeit</legend>
        <button type="button" class="chip" data-f="zeit" data-v="20">≤ 20 min</button>
        <button type="button" class="chip" data-f="zeit" data-v="35">≤ 35 min</button>
      </fieldset>

      <fieldset class="f-gruppe">
        <legend>Ablauf</legend>
        {(['dabei', 'kurz', 'halbe', 'einplanen'] as const).map((w) => (
          <button type="button" class="chip" data-f="warte" data-v={w}>{WARTE_LABEL[w]}</button>
        ))}
      </fieldset>

      {geraete.length > 0 && (
        <fieldset class="f-gruppe">
          <legend>Gerät</legend>
          {geraete.map((g) => (
            <button type="button" class="chip" data-f="geraet" data-v={g}>{GERAET_LABEL[g] ?? g}</button>
          ))}
        </fieldset>
      )}

      <fieldset class="f-gruppe">
        <legend>Art</legend>
        {kategorien.map((k) => (
          <button type="button" class="chip" data-f="kat" data-v={k}>{katLabel(k)}</button>
        ))}
      </fieldset>

      <fieldset class="f-gruppe">
        <legend>Merkmal</legend>
        {topTags.map(([t, n]) => (
          <button type="button" class="chip" data-f="tag" data-v={t}>{t} <span class="chip-n">{n}</span></button>
        ))}
      </fieldset>

      <button type="button" class="btn ghost" id="fReset" hidden>Filter zurücksetzen</button>
    </form>

    <p class="count" id="fCount" aria-live="polite"></p>

    <div class="liste" id="liste">
      {alle.map((r, i) => <Rezeptkarte r={r} form="normal" eager={i < 4} />)}
      <p class="empty" id="fLeer" hidden>Nichts gefunden — Filter zurücksetzen?</p>
    </div>
  </div>

  <Kartenlogik />

  <script is:inline>
    (() => {
      const karten = [...document.querySelectorAll('.rk')];
      const q = document.getElementById('fQ');
      const zaehler = document.getElementById('fCount');
      const leer = document.getElementById('fLeer');
      const reset = document.getElementById('fReset');
      const chips = [...document.querySelectorAll('.chip[data-f]')];

      // Zustand lebt in der URL. Vorher hatte jeder Filterzustand dieselbe
      // Adresse: nicht teilbar, nicht als Lesezeichen speicherbar, und der
      // Zurück-Knopf verliess die Seite statt den Filter zu raeumen.
      function lesen() {
        const p = new URLSearchParams(location.search);
        return {
          q: (p.get('q') || '').toLowerCase(),
          zeit: p.get('zeit') || '',
          warte: p.get('warte') || '',
          geraet: p.get('geraet') || '',
          kat: p.get('kat') || '',
          tag: p.get('tag') || '',
        };
      }
      function schreiben(s, ersetzen) {
        const p = new URLSearchParams();
        for (const [k, v] of Object.entries(s)) if (v) p.set(k, v);
        const neu = p.toString() ? `?${p}` : location.pathname;
        history[ersetzen ? 'replaceState' : 'pushState'](null, '', neu);
      }

      function anwenden() {
        const s = lesen();
        q.value = s.q;
        for (const c of chips) {
          c.setAttribute('aria-pressed', String(s[c.dataset.f] === c.dataset.v));
        }
        let n = 0;
        for (const k of karten) {
          const aktiv = Number(k.dataset.aktiv) || 0;
          const ok =
            (!s.q || k.dataset.titel.includes(s.q) || (k.dataset.tags || '').includes(s.q)) &&
            (!s.zeit || (aktiv > 0 && aktiv <= Number(s.zeit))) &&
            (!s.warte || k.dataset.warte === s.warte) &&
            (!s.geraet || (k.dataset.geraete || '').split(' ').includes(s.geraet)) &&
            (!s.kat || k.dataset.kat === s.kat) &&
            (!s.tag || (k.dataset.tags || '').split(' ').includes(s.tag));
          k.hidden = !ok;
          if (ok) n++;
        }
        zaehler.textContent = n === karten.length ? `${n} Rezepte` : `${n} von ${karten.length} Rezepten`;
        leer.hidden = n > 0;
        reset.hidden = !Object.values(s).some(Boolean);
      }

      for (const c of chips) {
        c.addEventListener('click', () => {
          const s = lesen();
          // Erneutes Antippen hebt auf — Filter loeschen einander nicht mehr
          // gegenseitig, sie sind kombinierbar.
          s[c.dataset.f] = s[c.dataset.f] === c.dataset.v ? '' : c.dataset.v;
          schreiben(s);
          anwenden();
        });
      }
      let tippTimer;
      q.addEventListener('input', () => {
        clearTimeout(tippTimer);
        tippTimer = setTimeout(() => {
          const s = lesen();
          s.q = q.value.trim();
          schreiben(s, true);
          anwenden();
        }, 200);
      });
      reset.addEventListener('click', () => {
        history.pushState(null, '', location.pathname);
        anwenden();
      });
      window.addEventListener('popstate', anwenden);
      anwenden();
    })();
  </script>
</Base>
