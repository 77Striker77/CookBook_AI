---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { parseZutaten, formatMenge, mitGruppen } from '../../lib/zutaten';
import { katLabel, zeitLabel, arbeitLabel, GERAET_LABEL, vtName } from '../../lib/darstellung';

export async function getStaticPaths() {
  const rezepte = await getCollection('rezepte');
  return rezepte.map((r) => ({ params: { slug: r.id }, props: { r } }));
}

const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);
const zutaten = parseZutaten(d.zutaten);

const URTEIL: Record<string, string> = {
  nochmal: 'Nochmal ✓', ok: 'War ok', nein: 'Eher nicht',
};

const anzeige = mitGruppen(zutaten);

const quelleText: Record<string, string> = {
  instagram: 'Instagram', web: 'Web', scan: 'Scan', eigen: 'Eigenkreation', familie: 'Familienrezept',
};
---

<Base
  titel={d.titel}
  beschreibung={`${katLabel(d.kategorie)} · ${d.portionen} Portionen${zeitLabel(d.zeit_gesamt) ? ` · ${zeitLabel(d.zeit_gesamt)}` : ''}`}
  bild={d.bild}
>
  <div class="wrap recipe" data-pagefind-body>
    <p class="crumb"><a href={url('/')}>Rezepte</a> › {katLabel(d.kategorie)}</p>
    <h1>{d.titel}</h1>

    {/* Eckdaten: EIN Stil für alles. Vorher standen hier sechs Pillen in drei
        Färbungen, und Orange bedeutete abwechselnd „Zeit", „die Ziffer 2" und
        „Gerät" — eine Farbe ohne Bedeutung ist Dekoration. Unterschieden wird
        jetzt über Position, nicht über Farbe. Der Akzent bleibt der
        Interaktion vorbehalten (Tags weiter unten sind Links). */}
    {arbeitLabel(d.zeit_aktiv, d.zeit_gesamt) && (
      <p class="leitzahl">{arbeitLabel(d.zeit_aktiv, d.zeit_gesamt)}</p>
    )}

    <ul class="eckdaten">
      <li>{d.portionen} Portionen</li>
      {(d.geraete ?? []).map((g: string) => <li>{GERAET_LABEL[g] ?? g}</li>)}
      {d.küche && <li>{d.küche}</li>}
      {d.bewertung && <li class="eck-urteil">{URTEIL[d.bewertung] ?? d.bewertung}</li>}
    </ul>

    {d.tags.length > 0 && (
      <p class="tagrow">
        {d.tags.map((t) => <a class="tag" href={url(`/rezepte?tag=${t}`)}>{t}</a>)}
      </p>
    )}

    {d.bild && (
      <figure class="hero-bild" style={`view-transition-name: ${vtName(r.id)}`}>
        <Image src={d.bild} alt={d.titel} widths={[480, 800, 1200]} sizes="(max-width: 780px) 100vw, 720px" />
      </figure>
    )}

    <div class="layout">
      <aside class="zutaten-box" id="zbox" data-basis={d.portionen}>
        <a class="btn kochen-btn" href={url(`/kochen/${r.id}`)}>Jetzt kochen →</a>
        <button class="btn plan-btn" id="planBtn" data-slug={r.id} aria-pressed="false">
          <span class="ic">🛒</span><span class="lbl">In den Kochplan</span>
        </button>
        <p class="zuletzt" id="zuletzt" hidden></p>

        {/* Auf dem Handy klappbar und klebend: Beim Lesen springt man ständig
            zwischen Zutaten und Zubereitung, vorher lagen sie untereinander
            und man scrollte bei jedem Schritt hoch und wieder zurück.
            Dasselbe Muster wie im Kochmodus.
            <details> statt Button, damit ohne JavaScript alles offen bleibt —
            der bisherige Zustand, also keine Verschlechterung. */}
        <details class="z-klapp" id="zKlapp" open>
          <summary class="z-kopf">
            <span class="z-titel">Zutaten</span>
            <span class="z-zahl">{zutaten.length}</span>
          </summary>

          <div class="portionen">
            <span class="lbl">Portionen</span>
            <div class="stepper">
              <button id="minus" aria-label="weniger">−</button>
              <span class="val" id="pval">{d.portionen}</span>
              <button id="plus" aria-label="mehr">+</button>
            </div>
          </div>

          <ul class="zutaten">
          {anzeige.map((zeile) => zeile.typ === 'grp'
            ? <li class="grp">{zeile.text}</li>
            : (
              <li>
                <span
                  class="menge"
                  data-base={zeile.z.skalierbar ? String(zeile.z.menge) : ''}
                  data-basemax={zeile.z.skalierbar && zeile.z.mengeMax !== null ? String(zeile.z.mengeMax) : ''}
                  data-einheit={zeile.z.einheit ?? ''}
                >{[
                  zeile.z.menge !== null ? (zeile.z.mengeMax ? `${formatMenge(zeile.z.menge)}–${formatMenge(zeile.z.mengeMax)}` : formatMenge(zeile.z.menge)) : '',
                  zeile.z.einheit ?? '',
                ].filter(Boolean).join(' ')}</span>
                <span class="znam"><a href={url(`/zutat/${zeile.z.slug}`)}>{zeile.z.name}</a>{zeile.z.notiz && <span class="znotiz">, {zeile.z.notiz}</span>}</span>
              </li>
            ))}
          </ul>
        </details>
      </aside>

      <div class="zubereitung reading">
        {/* Sichtbar machen, statt still falsch zu rechnen: Der Portionsrechner
            skaliert die Zutatenliste, nicht den Fließtext. Ein Trockenlauf über
            alle 18 Rezepte zeigte, dass von 32 Mengenangaben im Text nur 5
            skaliert werden dürften — der Rest sind Makros pro Portion,
            Umrechnungstabellen, Glasgrößen und feste Toleranzen. Eine stille
            Umrechnung wäre öfter falsch als richtig. */}
        <p class="mengen-hinweis" id="mengenHinweis" hidden>
          <b>Achtung:</b> Die Mengen <em>im Text</em> gelten unverändert für
          <span id="mhBasis"></span> Portionen — nur die Zutatenliste ist auf
          <span id="mhZiel"></span> umgerechnet.
        </p>
        <Content />
        <p class="quelle">
          Quelle: {quelleText[d.quelle?.typ ?? 'eigen']}
          {d.quelle?.autor && ` · ${d.quelle.autor}`}
          {d.quelle?.url && <> · <a href={d.quelle.url} rel="noreferrer">Original</a></>}
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const box = document.getElementById('zbox');
      const basis = Number(box.dataset.basis) || 1;
      let ziel = basis;
      const pval = document.getElementById('pval');
      const mengen = [...box.querySelectorAll('.menge')];

      function fmt(w) {
        if (w === null || Number.isNaN(w)) return '';
        const ganz = Math.floor(w), rest = w - ganz;
        const br = [[0.25,'¼'],[0.5,'½'],[0.75,'¾'],[1/3,'⅓'],[2/3,'⅔']];
        for (const [f, s] of br) if (Math.abs(rest - f) < 0.02) return ganz > 0 ? `${ganz} ${s}` : s;
        return String(Math.round(w * 100) / 100).replace('.', ',');
      }
      function render() {
        const faktor = ziel / basis;
        for (const el of mengen) {
          const b = el.dataset.base;
          if (b === '') continue;
          const einheit = el.dataset.einheit;
          const bmax = el.dataset.basemax;
          let txt = fmt(Number(b) * faktor);
          if (bmax) txt += '–' + fmt(Number(bmax) * faktor);
          el.textContent = [txt, einheit].filter(Boolean).join(' ');
        }
        pval.textContent = ziel;
        hinweisZeichnen();
      }

      // Der Hinweis erscheint nur, wenn die Portionszahl abweicht — und
      // markiert dann die betroffenen Stellen im Text, damit man sie beim
      // Lesen nicht übersieht.
      const hinweis = document.getElementById('mengenHinweis');
      const zub = document.querySelector('.zubereitung');
      let markiert = false;
      function textMengenMarkieren() {
        if (markiert) return;
        markiert = true;
        // Als Literal, nicht als String zusammengebaut — sonst gehen die
        // Escapes beim Erzeugen der Datei verloren.
        const muster = /(\d+(?:[.,]\d+)?|[½¼¾⅓⅔])\s*(g|kg|ml|l|Liter|EL|TL|Esslöffel|Teelöffel|Prisen?|Zehen?|Bund|Dosen?|Packungen?|Scheiben?)\b/g;
        const lauf = document.createTreeWalker(zub, NodeFilter.SHOW_TEXT);
        const knoten = [];
        while (lauf.nextNode()) knoten.push(lauf.currentNode);
        const maskiere = (t) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
        for (const k of knoten) {
          if (!muster.test(k.nodeValue)) continue;
          muster.lastIndex = 0;
          const huelle = document.createElement('span');
          // Erst maskieren, dann die Marker einsetzen — sonst wuerde ein „&"
          // im Rezepttext als Entity-Anfang gelesen.
          huelle.innerHTML = maskiere(k.nodeValue).replace(muster, '<mark class="textmenge">$&</mark>');
          k.parentNode.replaceChild(huelle, k);
        }
      }
      function hinweisZeichnen() {
        const abweichend = ziel !== basis;
        hinweis.hidden = !abweichend;
        zub.classList.toggle('mengen-abweichend', abweichend);
        if (abweichend) {
          document.getElementById('mhBasis').textContent = basis;
          document.getElementById('mhZiel').textContent = ziel;
          textMengenMarkieren();
        }
      }
      document.getElementById('plus').addEventListener('click', () => { ziel++; render(); syncPlan(); });
      document.getElementById('minus').addEventListener('click', () => { if (ziel > 1) { ziel--; render(); syncPlan(); } });

      // Auf dem Handy eingeklappt starten — auf breiten Schirmen steht die
      // Spalte ohnehin daneben und soll offen bleiben.
      const klapp = document.getElementById('zKlapp');
      const schmal = window.matchMedia('(max-width: 780px)');
      function klappAnpassen(e) { klapp.open = !e.matches; }
      klappAnpassen(schmal);
      schmal.addEventListener('change', klappAnpassen);

      // Kochplan-Button: fügt dieses Rezept mit der aktuell gewählten Portionszahl
      // hinzu bzw. entfernt es wieder. Ist es schon im Plan, spiegelt der Stepper
      // die gemerkte Portionszahl.
      const btn = document.getElementById('planBtn');
      const slug = btn.dataset.slug;
      const label = btn.querySelector('.lbl');

      function drin() { return window.WSPlan?.has(slug); }
      function paint() {
        const on = drin();
        btn.setAttribute('aria-pressed', String(on));
        btn.classList.toggle('on', on);
        label.textContent = on ? '✓ Im Kochplan' : 'In den Kochplan';
      }
      // Beim Laden gemerkte Portionszahl übernehmen, falls schon im Plan.
      const vorhanden = (window.WSPlan?.read() || []).find((e) => e.slug === slug);
      if (vorhanden) { ziel = vorhanden.ziel; render(); }
      paint();

      function syncPlan() { if (drin()) window.WSPlan.setPortion(slug, ziel); }
      btn.addEventListener('click', () => { window.WSPlan.toggle(slug, ziel); paint(); });
      window.addEventListener('ws-plan-change', paint);

      // Kochverlauf anzeigen — die Belohnung fürs Eintragen kommt sofort,
      // nicht erst nach einem Merge.
      const zuletzt = document.getElementById('zuletzt');
      function paintVerlauf() {
        const label = window.WSKoch?.label(slug);
        const n = window.WSKoch?.anzahl(slug) ?? 0;
        zuletzt.hidden = !label;
        if (label) zuletzt.textContent = n > 1 ? `${label} · ${n}× gekocht` : label;
      }
      window.addEventListener('ws-koch-change', paintVerlauf);
      paintVerlauf();
    })();
  </script>
</Base>
