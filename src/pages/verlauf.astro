---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { katLabel } from '../lib/darstellung';

const alle = await getCollection('rezepte');

// Nachschlagewerk für die Client-Seite: Der Verlauf kennt nur Slugs, die
// Anzeige braucht Titel und Kategorie. Klein genug, um inline zu stehen.
const katalog = Object.fromEntries(
  alle.map((r) => [r.id, { titel: r.data.titel, kat: katLabel(r.data.kategorie) }]),
);

// Bereits im Frontmatter persistierte Kochdaten. Der Browser-Verlauf legt
// sich darüber; doppelte Daten fallen beim Zusammenführen zusammen.
const ausRepo = Object.fromEntries(
  alle
    .filter((r) => (r.data.gekocht ?? []).length > 0)
    .map((r) => [
      r.id,
      (r.data.gekocht ?? []).map((d: Date) => new Date(d).toISOString().slice(0, 10)),
    ]),
);

const issueBasis =
  'https://github.com/77Striker77/CookBook_AI/issues/new?template=kochverlauf.yml&title=' +
  encodeURIComponent('[Verlauf] ');
---

<Base titel="Verlauf" beschreibung="Was wir wann gekocht haben.">
  <div class="wrap verlauf-wrap">
    <p class="eyebrow">Koch-Tagebuch</p>
    <h1>Verlauf</h1>

    <p class="v-intro">
      Was im Kochmodus eingetragen wird, landet zuerst hier im Browser — sofort
      sichtbar, ohne Umweg. Damit es dauerhaft im Kochbuch steht, auf beiden
      Geräten erscheint und ein Löschen der Browserdaten übersteht, wird es
      unten einmal übertragen.
    </p>

    <section class="v-leer" id="vLeer" hidden>
      <p>Noch nichts eingetragen.</p>
      <p class="muted">
        Öffne ein Rezept, tippe auf <b>Jetzt kochen</b> und am Ende auf
        <b>Gekocht ✓</b>.
      </p>
      <a class="btn" href={url('/')}>Rezepte durchstöbern</a>
    </section>

    <div id="vInhalt" hidden>
      <div class="v-zahlen" id="vZahlen"></div>

      <section class="v-block">
        <h2>Lange nicht gekocht</h2>
        <p class="v-hinweis">
          Aus dem, was schon einmal auf dem Tisch stand — nach der Zeit sortiert.
        </p>
        <ul class="v-liste" id="vAlt"></ul>
      </section>

      <section class="v-block">
        <h2>Zuletzt gekocht</h2>
        <ul class="v-liste" id="vNeu"></ul>
      </section>

      <section class="v-block v-export">
        <h2>Ins Kochbuch übertragen</h2>
        <p class="v-hinweis">
          Erzeugt eine vorbefüllte Einreichung im Briefkasten. Der Agent
          schreibt die Daten ins Rezept, danach stehen sie fest im Repo.
        </p>
        <a class="btn primary" id="vExport" href={issueBasis} target="_blank" rel="noreferrer">
          Einreichung erzeugen →
        </a>
        <p class="v-hinweis" id="vExportZahl"></p>
        <details class="v-roh">
          <summary>Rohdaten ansehen</summary>
          <pre id="vRoh"></pre>
        </details>
      </section>

      <p class="v-fuss">
        <button class="btn ghost danger" id="vLeeren">Browser-Verlauf löschen</button>
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ katalog, ausRepo, issueBasis }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      const URTEIL = { nochmal: 'Nochmal', ok: 'War ok', nein: 'Eher nicht' };

      function heuteMinus(datum) {
        const ms = Date.now() - new Date(datum + 'T12:00:00').getTime();
        return Math.max(0, Math.floor(ms / 86400000));
      }
      function label(tage) {
        if (tage === 0) return 'heute';
        if (tage === 1) return 'gestern';
        if (tage < 7) return `vor ${tage} Tagen`;
        if (tage < 14) return 'vor einer Woche';
        if (tage < 60) return `vor ${Math.round(tage / 7)} Wochen`;
        return `vor ${Math.round(tage / 30)} Monaten`;
      }

      /** Repo-Daten und Browser-Daten zusammenführen, Duplikate fallen weg. */
      function zusammen() {
        const browser = window.WSKoch?.read() ?? [];
        const eintraege = browser.map((e) => ({ ...e, quelle: 'browser' }));
        for (const [slug, daten] of Object.entries(ausRepo)) {
          for (const d of daten) {
            if (!eintraege.some((e) => e.slug === slug && e.datum === d)) {
              eintraege.push({ slug, datum: d, urteil: null, quelle: 'repo' });
            }
          }
        }
        return eintraege.sort((a, b) => b.datum.localeCompare(a.datum));
      }

      function zeile(e, zeigeUrteil) {
        const info = katalog[e.slug];
        if (!info) return '';
        const tage = heuteMinus(e.datum);
        const u = e.urteil ? `<span class="v-urteil v-${e.urteil}">${URTEIL[e.urteil]}</span>` : '';
        return `<li>
          <a href="${'/rezept/' + e.slug}">${info.titel}</a>
          <span class="v-meta">${label(tage)}${e.quelle === 'repo' ? ' · im Kochbuch' : ''}</span>
          ${zeigeUrteil ? u : ''}
        </li>`;
      }

      function zeichnen() {
        const alleE = zusammen();
        $('vLeer').hidden = alleE.length > 0;
        $('vInhalt').hidden = alleE.length === 0;
        if (!alleE.length) return;

        // Kennzahlen
        const slugs = [...new Set(alleE.map((e) => e.slug))];
        const proSlug = slugs.map((s) => ({
          slug: s,
          n: alleE.filter((e) => e.slug === s).length,
          letzte: alleE.find((e) => e.slug === s).datum,
        }));
        const oft = [...proSlug].sort((a, b) => b.n - a.n)[0];
        $('vZahlen').innerHTML = `
          <span><b>${alleE.length}</b> Mal gekocht</span>
          <span><b>${slugs.length}</b> verschiedene Rezepte</span>
          ${oft && oft.n > 1 ? `<span>am häufigsten: <b>${katalog[oft.slug]?.titel ?? oft.slug}</b> (${oft.n}×)</span>` : ''}
        `;

        // Lange nicht gekocht — nur was schon einmal dran war.
        const alt = [...proSlug]
          .sort((a, b) => a.letzte.localeCompare(b.letzte))
          .slice(0, 6)
          .map((p) => ({ slug: p.slug, datum: p.letzte, urteil: window.WSKoch?.urteil(p.slug) }));
        $('vAlt').innerHTML = alt.map((e) => zeile(e, true)).join('') || '<li class="muted">—</li>';

        $('vNeu').innerHTML = alleE.slice(0, 12).map((e) => zeile(e, true)).join('');

        // Export: nur Browser-Daten, das Repo kennt seine schon.
        const neu = (window.WSKoch?.read() ?? []).filter(
          (e) => !(ausRepo[e.slug] ?? []).includes(e.datum),
        );
        const roh = neu
          .map((e) => `${e.slug} · ${e.datum}${e.urteil ? ' · ' + e.urteil : ''}`)
          .join('\n');
        $('vRoh').textContent = roh || '(nichts Neues)';
        $('vExportZahl').textContent = neu.length
          ? `${neu.length} Eintrag${neu.length === 1 ? '' : 'e'} noch nicht im Kochbuch.`
          : 'Alles bereits übertragen.';
        const btn = $('vExport');
        btn.href = issueBasis + '&daten=' + encodeURIComponent(roh);
        btn.setAttribute('aria-disabled', String(neu.length === 0));
      }

      $('vLeeren').addEventListener('click', () => {
        if (!confirm('Browser-Verlauf löschen? Bereits übertragene Einträge bleiben im Kochbuch.')) return;
        window.WSKoch.leeren();
      });

      window.addEventListener('ws-koch-change', zeichnen);
      zeichnen();
    })();
  </script>
</Base>
