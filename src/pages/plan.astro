---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { katLabel, arbeitLabel } from '../lib/darstellung';

const rezepte = await getCollection('rezepte');
const katalog = Object.fromEntries(
  rezepte.map((r) => [
    r.id,
    {
      titel: r.data.titel,
      basis: r.data.portionen,
      kategorie: katLabel(r.data.kategorie),
      zeit: arbeitLabel(r.data.zeit_aktiv, r.data.zeit_gesamt) ?? '',
    },
  ]),
);
const katalogJson = JSON.stringify(katalog).replace(/</g, '\\u003c');

// Wochentage. Laut Mealies eigener Nutzerumfrage planen viele lieber als
// Warteschlange statt auf feste Tage — deshalb ist „ohne Tag" ein
// gleichwertiger Zustand und nicht ein Mangel.
const TAGE = ['Ohne Tag', 'Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'];
---

<Base titel="Kochplan" beschreibung="Was diese Woche gekocht wird.">
  <div class="wrap plan-seite">
    <div class="ek-kopf">
      <h1>Kochplan</h1>
      <p class="ek-fortschritt" id="planZahl" aria-live="polite"></p>
    </div>

    <div id="planLeer" class="leer-box" hidden>
      <p>Dein Kochplan ist noch leer.</p>
      <p class="muted">Tippe auf das <b>+</b> an einer Rezeptkarte oder auf <b>In den Kochplan</b> im Rezept.</p>
      <a class="btn primary" href={url('/')}>Rezepte ansehen</a>
    </div>

    <div id="planInhalt" hidden>
      <div id="planTage"></div>
      <p class="plan-hinweis">
        Aus diesem Plan entsteht die <a href={url('/einkauf')}>Einkaufsliste</a> —
        Mengen auf deine Portionen gerechnet und zusammengezählt.
      </p>
      <button class="btn ghost small danger" id="planLeeren">Plan leeren</button>
    </div>
  </div>

  <script define:vars={{ TAGE }}>
    const katalog = JSON.parse(document.getElementById('katalog').textContent);
    const leerEl = document.getElementById('planLeer');
    const inhaltEl = document.getElementById('planInhalt');
    const tageEl = document.getElementById('planTage');
    const zahlEl = document.getElementById('planZahl');

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const basis = document.querySelector('link[rel="manifest"]').getAttribute('href').replace(/\/manifest\.webmanifest$/, '');

    function render() {
      const plan = window.WSPlan.read().filter((e) => katalog[e.slug]);
      leerEl.hidden = plan.length > 0;
      inhaltEl.hidden = plan.length === 0;
      zahlEl.textContent = plan.length
        ? `${plan.length} ${plan.length === 1 ? 'Rezept' : 'Rezepte'}` : '';
      if (!plan.length) return;

      tageEl.innerHTML = '';
      for (let t = 0; t < TAGE.length; t++) {
        const drin = plan.filter((e) => (e.tag ?? 0) === t);
        // Leere Wochentage nur zeigen, wenn ueberhaupt nach Tagen geplant wird.
        const nachTagen = plan.some((e) => (e.tag ?? 0) > 0);
        if (!drin.length && (t === 0 || !nachTagen)) continue;

        const sec = document.createElement('section');
        sec.className = 'plan-tag';
        sec.innerHTML = `<h2>${esc(TAGE[t])}</h2><ul>${drin.map((e) => {
          const r = katalog[e.slug];
          return `<li class="plan-zeile">
            <div class="pz-text">
              <a class="pz-titel" href="${basis}/rezept/${esc(e.slug)}">${esc(r.titel)}</a>
              <span class="pz-meta">${esc(r.kategorie)}${r.zeit ? ' · ' + esc(r.zeit) : ''}</span>
            </div>
            <div class="pz-stepper" data-slug="${esc(e.slug)}">
              <button class="minus" aria-label="weniger Portionen">−</button>
              <span class="pz-portion">${e.ziel}</span>
              <button class="plus" aria-label="mehr Portionen">+</button>
            </div>
            <select class="pz-tag" data-slug="${esc(e.slug)}" aria-label="Wochentag">
              ${TAGE.map((n, i) => `<option value="${i}"${i === (e.tag ?? 0) ? ' selected' : ''}>${esc(n)}</option>`).join('')}
            </select>
            <button class="pz-weg" data-slug="${esc(e.slug)}" aria-label="Aus dem Plan entfernen">×</button>
          </li>`;
        }).join('')}</ul>`;
        tageEl.appendChild(sec);
      }
    }

    tageEl.addEventListener('click', (ev) => {
      const step = ev.target.closest('.pz-stepper');
      if (step) {
        const e = window.WSPlan.read().find((x) => x.slug === step.dataset.slug);
        if (!e) return;
        if (ev.target.classList.contains('plus')) window.WSPlan.setPortion(e.slug, e.ziel + 1);
        else if (ev.target.classList.contains('minus') && e.ziel > 1) window.WSPlan.setPortion(e.slug, e.ziel - 1);
        return;
      }
      const weg = ev.target.closest('.pz-weg');
      if (weg) window.WSPlan.remove(weg.dataset.slug);
    });
    tageEl.addEventListener('change', (ev) => {
      const sel = ev.target.closest('.pz-tag');
      if (sel) window.WSPlan.setTag(sel.dataset.slug, Number(sel.value));
    });
    document.getElementById('planLeeren').addEventListener('click', () => {
      if (confirm('Kompletten Kochplan leeren?')) window.WSPlan.clear();
    });

    window.addEventListener('ws-plan-change', render);
    render();
  </script>

  <script type="application/json" id="katalog" set:html={katalogJson}></script>
</Base>
