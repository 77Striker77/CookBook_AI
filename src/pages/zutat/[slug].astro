---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rezeptkarte from '../../components/Rezeptkarte.astro';
import Kartenlogik from '../../components/Kartenlogik.astro';
import { url } from '../../lib/url';
import { parseZutaten } from '../../lib/zutaten';

export async function getStaticPaths() {
  const rezepte = await getCollection('rezepte');

  // Kanonische Zutat -> Liste der Rezepte, die sie verwenden.
  const index = new Map<string, { name: string; rezepte: any[] }>();
  for (const r of rezepte) {
    const gesehen = new Set<string>();
    for (const z of parseZutaten(r.data.zutaten)) {
      if (gesehen.has(z.slug)) continue;
      gesehen.add(z.slug);
      if (!index.has(z.slug)) index.set(z.slug, { name: z.kanonisch, rezepte: [] });
      index.get(z.slug)!.rezepte.push(r);
    }
  }

  // Nur ab zwei Rezepten. Eine Seite „Wasser" oder „Salz" mit einem einzigen
  // Treffer beantwortet keine Frage — sie kostet nur Build-Zeit und erzeugt
  // Registereinträge ohne Aussage. Von 122 kanonischen Zutaten kommen 68 in
  // genau einem Rezept vor.
  return [...index.entries()]
    .filter(([, e]) => e.rezepte.length >= 2)
    .map(([slug, eintrag]) => ({
      params: { slug },
      props: { name: eintrag.name, rezepte: eintrag.rezepte },
    }));
}

const { name, rezepte } = Astro.props;
rezepte.sort((a: any, b: any) => a.data.titel.localeCompare(b.data.titel, 'de'));
---

<Base titel={name} beschreibung={`${rezepte.length} Rezepte mit ${name}`}>
  <div class="wrap katalog">
    <p class="crumb"><a href={url('/')}>Rezepte</a> › Zutat</p>
    <h1>{name}</h1>
    <p class="s-unter">
      {rezepte.length} Rezepte verwenden diese Zutat.
    </p>

    <div class="liste">
      {rezepte.map((r: any, i: number) => <Rezeptkarte r={r} form="normal" eager={i < 3} />)}
    </div>
  </div>

  <Kartenlogik />
</Base>
